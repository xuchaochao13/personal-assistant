/* ========================================
   Design System — Amex-Inspired Premium
   ======================================== */

/* Design Tokens */
page {
  --color-primary: #006FCF;
  --color-primary-dark: #002663;
  --color-primary-light: #E8F1FB;
  --color-bg: #F4F6F8;
  --color-surface: #FFFFFF;
  --color-text: #111827;
  --color-text-secondary: #64748B;
  --color-border: #E5E7EB;
  --color-success: #059669;
  --color-warning: #D97706;
  --color-error: #DC2626;

  --space-xs: 4px;
  --space-sm: 8px;
  --space-md: 12px;
  --space-base: 16px;
  --space-lg: 20px;
  --space-xl: 24px;
  --space-2xl: 32px;

  --text-xs: 11px;
  --text-sm: 13px;
  --text-base: 15px;
  --text-lg: 17px;
  --text-xl: 22px;
  --text-2xl: 28px;
  --text-3xl: 36px;

  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-full: 9999px;

  --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
  --shadow-md: 0 1px 3px rgba(0,0,0,0.06), 0 1px 2px rgba(0,0,0,0.04);
  --shadow-lg: 0 4px 12px rgba(0,0,0,0.08);
  --shadow-fab: 0 4px 16px rgba(0,111,207,0.25);

  background: var(--color-bg);
  font-size: var(--text-base);
  color: var(--color-text);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  box-sizing: border-box;
}

view, text, image, input, button, textarea, scroll-view, navigator, picker {
  box-sizing: border-box;
}

/* ========================================
   Layout
   ======================================== */

.container {
  padding: var(--space-xl);
}

/* ========================================
   Cards
   ======================================== */

.card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-md);
  border: 1px solid var(--color-border);
  box-sizing: border-box;
  transition: box-shadow 200ms ease, transform 200ms ease;
}

.card:active {
  box-shadow: var(--shadow-lg);
  transform: scale(0.995);
}

.card-premium {
  background: linear-gradient(135deg, #006FCF, #002663);
  color: #FFFFFF;
  border: none;
}

.card-premium .text-muted {
  color: rgba(255,255,255,0.75);
}

/* ========================================
   Buttons
   ======================================== */

.btn-primary {
  background: linear-gradient(135deg, #006FCF, #0059B3);
  color: #FFFFFF;
  border-radius: var(--radius-sm);
  padding: 12px 24px;
  font-size: var(--text-base);
  font-weight: 600;
  text-align: center;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 8px rgba(0,111,207,0.2);
  transition: opacity 200ms ease, box-shadow 200ms ease;
}

.btn-primary:active {
  opacity: 0.9;
  box-shadow: 0 4px 16px rgba(0,111,207,0.35);
}

.btn-primary[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

.btn-primary::after {
  border: none;
  border-radius: inherit;
}

.btn-secondary {
  background: var(--color-surface);
  color: var(--color-primary);
  border: 1.5px solid var(--color-primary);
  border-radius: var(--radius-sm);
  padding: 12px 24px;
  font-size: var(--text-base);
  font-weight: 500;
  text-align: center;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 200ms ease;
}

.btn-secondary:active {
  background: var(--color-primary-light);
}

.btn-secondary::after {
  border: none;
  border-radius: inherit;
}

/* ========================================
   Typography
   ======================================== */

.text-muted {
  color: var(--color-text-secondary);
  font-size: var(--text-sm);
}

/* ========================================
   Empty State
   ======================================== */

.empty-state {
  text-align: center;
  padding: 64px 24px;
}

.empty-state-line {
  width: 20px;
  height: 2px;
  background: #D1D5DB;
  margin: 0 auto 18px;
  border-radius: 1px;
}

.empty-state-label {
  font-size: 16px;
  font-weight: 700;
  color: #111827;
  margin-bottom: 8px;
}

.empty-state-hint {
  font-size: 13px;
  color: #94A3B8;
}

/* ========================================
   FAB (Floating Action Button)
   ======================================== */

.fab {
  position: fixed;
  bottom: 70px;
  right: 20px;
  width: 56px;
  height: 56px;
  background: linear-gradient(135deg, #006FCF, #0059B3);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 300;
  box-shadow: var(--shadow-fab);
  z-index: 99;
  transition: transform 200ms ease, box-shadow 200ms ease;
}

.fab:active {
  transform: scale(0.92);
  box-shadow: 0 6px 24px rgba(0,111,207,0.35);
}

/* ========================================
   Dividers
   ======================================== */

.divider {
  height: 1px;
  background: var(--color-border);
  margin: var(--space-base) 0;
}

/* ========================================
   Badges / Chips
   ======================================== */

.badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 10px;
  font-size: var(--text-xs);
  font-weight: 600;
  border-radius: var(--radius-full);
  letter-spacing: 0.5px;
}

.badge-primary {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

.badge-success {
  background: #ECFDF5;
  color: var(--color-success);
}

.badge-warning {
  background: #FFFBEB;
  color: var(--color-warning);
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  font-size: var(--text-sm);
  border-radius: var(--radius-full);
  background: #F1F5F9;
  color: var(--color-text-secondary);
  transition: all 200ms ease;
}

.chip.active {
  background: var(--color-primary);
  color: #FFFFFF;
}

/* ========================================
   Form Elements
   ======================================== */

.form-card {
  background: var(--color-surface);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  border: 1px solid var(--color-border);
}

.form-label {
  font-size: var(--text-xs);
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 1px;
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.form-input {
  width: 100%;
  min-height: 44px;
  padding: 10px 14px;
  font-size: var(--text-base);
  background: #F9FAFB;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  box-sizing: border-box;
  transition: border-color 200ms ease, box-shadow 200ms ease;
}

.form-input:focus {
  border-color: var(--color-primary);
  box-shadow: 0 0 0 3px rgba(0,111,207,0.1);
  background: #FFFFFF;
}

/* ========================================
   Page Transition
   ======================================== */

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to   { opacity: 1; transform: translateY(0); }
}

.container {
  animation: fadeIn 250ms ease;
}
