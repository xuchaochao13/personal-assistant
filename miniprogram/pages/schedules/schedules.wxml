<view class="container">
  <!-- View Tabs -->
  <view class="view-tabs">
    <view class="tab {{view === 'day' ? 'active' : ''}}" bindtap="switchView" data-view="day">日</view>
    <view class="tab {{view === 'week' ? 'active' : ''}}" bindtap="switchView" data-view="week">周</view>
    <view class="tab {{view === 'month' ? 'active' : ''}}" bindtap="switchView" data-view="month">月</view>
  </view>

  <!-- ============ DAY VIEW ============ -->
  <view wx:if="{{view === 'day'}}">
    <view class="date-nav">
      <view class="nav-arrow" bindtap="prevDay">←</view>
      <view class="date-text">{{currentDate}}
        <view wx:if="{{currentDate === today}}" class="today-badge">今天</view>
      </view>
      <view class="nav-arrow" bindtap="nextDay">→</view>
      <view class="today-btn" bindtap="goToday">今</view>
    </view>

    <view wx:if="{{schedules.length === 0}}" class="empty-state">
      <view class="empty-state-line"></view>
      <view class="empty-state-label">当日无日程</view>
      <view class="empty-state-hint">享受空闲时光，或添加新日程</view>
    </view>

    <view wx:for="{{schedules}}" wx:key="id" class="card schedule-card" bindtap="goEdit" data-id="{{item.id}}">
      <view class="schedule-timebar {{item.start_time < today ? 'past' : ''}}"></view>
      <view class="schedule-body">
        <view class="schedule-title">{{item.title}}</view>
        <view class="schedule-time">{{item.start_time.slice(11, 16)}} - {{item.end_time.slice(11, 16)}}</view>
        <view wx:if="{{item.description}}" class="schedule-desc">{{item.description}}</view>
      </view>
    </view>

    <view class="fab" bindtap="goNew">+</view>
  </view>

  <!-- ============ WEEK VIEW ============ -->
  <view wx:if="{{view === 'week'}}">
    <view class="week-nav">
      <view class="nav-arrow" bindtap="prevWeek">←</view>
      <view class="date-text">{{weekDays[0].date}} - {{weekDays[6].date}}</view>
      <view class="nav-arrow" bindtap="nextWeek">→</view>
      <view class="today-btn" bindtap="goToday">今</view>
    </view>

    <view class="week-strip">
      <view wx:for="{{weekDays}}" wx:key="date"
        class="week-day {{item.isToday ? 'today' : ''}} {{item.date === selectedDay ? 'selected' : ''}}"
        bindtap="selectWeekDay" data-date="{{item.date}}">
        <view class="week-day-name">{{item.weekday}}</view>
        <view class="week-day-num">{{item.dayNum}}</view>
        <view wx:if="{{groupedSchedules[item.date]}}" class="week-dot"></view>
      </view>
    </view>

    <view class="week-schedules-label">{{selectedDay}} 日程</view>

    <view wx:if="{{!groupedSchedules[selectedDay] || groupedSchedules[selectedDay].length === 0}}" class="empty-state">
      <view class="empty-state-line"></view>
      <view class="empty-state-label">当日无日程</view>
    </view>

    <view wx:for="{{groupedSchedules[selectedDay]}}" wx:key="id" class="card schedule-card" bindtap="goEdit" data-id="{{item.id}}">
      <view class="schedule-timebar {{item.start_time < today ? 'past' : ''}}"></view>
      <view class="schedule-body">
        <view class="schedule-title">{{item.title}}</view>
        <view class="schedule-time">{{item.start_time.slice(11, 16)}} - {{item.end_time.slice(11, 16)}}</view>
        <view wx:if="{{item.description}}" class="schedule-desc">{{item.description}}</view>
      </view>
    </view>

    <view class="fab" bindtap="goNew">+</view>
  </view>

  <!-- ============ MONTH VIEW ============ -->
  <view wx:if="{{view === 'month'}}">
    <view class="month-nav">
      <view class="nav-arrow" bindtap="prevMonth">←</view>
      <view class="date-text">{{monthLabel}}</view>
      <view class="nav-arrow" bindtap="nextMonth">→</view>
      <view class="today-btn" bindtap="goToday">今</view>
    </view>

    <view class="calendar">
      <view class="cal-header">
        <view wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="cal-hd">{{item}}</view>
      </view>
      <view class="cal-body">
        <view wx:for="{{monthDays}}" wx:key="index"
          class="cal-cell {{item.isOtherMonth ? 'other' : ''}} {{item.isToday ? 'today' : ''}}"
          bindtap="selectMonthDay" data-date="{{item.date}}">
          <view class="cal-num">{{item.dayNum}}</view>
          <view wx:if="{{item.date && busyDates[item.date]}}" class="cal-dot"></view>
        </view>
      </view>
    </view>

    <view class="fab" bindtap="goNew">+</view>
  </view>
</view>
