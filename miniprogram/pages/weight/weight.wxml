<view class="container">
  <view wx:if="{{stats.total}}" class="card weight-stats-card">
    <view class="card-title" style="font-size: 14px;">体重统计</view>
    <view class="stat-row">
      <view class="text-muted">范围</view>
      <view>{{stats.min_weight}}kg - {{stats.max_weight}}kg</view>
    </view>
    <view class="stat-row">
      <view class="text-muted">平均</view>
      <view>{{stats.avg_weight}}kg</view>
    </view>
    <view class="stat-row" style="border-bottom: none;">
      <view class="text-muted">记录次数</view>
      <view>{{stats.total}}</view>
    </view>
  </view>

  <view wx:if="{{records.length === 0}}" class="empty-state">
    <view class="empty-state-line"></view>
    <view class="empty-state-label">暂无体重记录</view>
    <view class="empty-state-hint">记录体重变化，关注健康</view>
  </view>

  <view wx:for="{{records}}" wx:key="id" class="card weight-card">
    <view class="weight-value">{{item.weight}}<view class="weight-unit">kg</view></view>
    <view class="weight-info">
      <view class="weight-date">{{item.recorded_at}}</view>
      <view class="weight-note" wx:if="{{item.note}}">{{item.note}}</view>
    </view>
    <view class="todo-del" data-id="{{item.id}}" bindtap="del">×</view>
  </view>

  <view wx:if="{{showForm}}" class="form-card">
    <view class="form-label">体重记录</view>
    <input class="form-input" value="{{weight}}" bindinput="onInput" data-key="weight" placeholder="体重(kg)" type="digit" />
    <view style="margin-top: 12px;">
      <picker mode="date" value="{{recorded_at}}" bindchange="setDate">
        <view class="form-input">{{recorded_at || '选择日期'}}</view>
      </picker>
    </view>
    <view style="margin-top: 12px;">
      <input class="form-input" value="{{note}}" bindinput="onInput" data-key="note" placeholder="备注（可选）" />
    </view>
    <view style="margin-top: 16px;">
      <button class="btn-primary" bindtap="save">保存记录</button>
    </view>
  </view>

  <view class="fab" bindtap="showAdd">+</view>
</view>
