.form-section {
  margin-bottom: 16px;
}

.priority-picker {
  display: flex;
  gap: 10px;
}

.p-item {
  flex: 1;
  padding: 10px 0;
  border-radius: 10px;
  border: 1.5px solid #E5E7EB;
  font-size: 14px;
  font-weight: 500;
  text-align: center;
  color: #64748B;
  background: #FFFFFF;
  transition: all 200ms ease;
}

.p-item.active {
  background: #006FCF;
  color: #FFFFFF;
  border-color: #006FCF;
  box-shadow: 0 2px 8px rgba(0,111,207,0.2);
}

.save-bar {
  margin-top: 24px;
}
