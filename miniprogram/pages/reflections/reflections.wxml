<view class="container">
  <view wx:if="{{reflections.length === 0}}" class="empty-state">
    <view class="empty-state-line"></view>
    <view class="empty-state-label">暂无反思记录</view>
    <view class="empty-state-hint">每日反思，助你成长</view>
  </view>

  <view wx:for="{{reflections}}" wx:key="id" class="card reflection-card" bindtap="goEdit" data-id="{{item.id}}">
    <view class="reflection-title">{{item.title}}</view>
    <view class="reflection-mood">{{item.moodLabel}}</view>
    <view class="reflection-preview">{{item.content}}</view>
  </view>

  <view class="fab" bindtap="goNew">+</view>
</view>
