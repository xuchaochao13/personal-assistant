<view class="container">
  <view class="form-item">
    <view class="label">标题</view>
    <input value="{{title}}" bindinput="onInput" data-key="title" placeholder="日程标题" />
  </view>
  <view class="form-item">
    <view class="label">描述</view>
    <input value="{{description}}" bindinput="onInput" data-key="description" placeholder="可选" />
  </view>
  <view class="form-item">
    <view class="label">开始时间</view>
    <input value="{{start_time}}" bindinput="onInput" data-key="start_time" placeholder="YYYY-MM-DD HH:MM" />
  </view>
  <view class="form-item">
    <view class="label">结束时间</view>
    <input value="{{end_time}}" bindinput="onInput" data-key="end_time" placeholder="YYYY-MM-DD HH:MM" />
  </view>
  <button class="btn-primary" bindtap="save">保存</button>
</view>
