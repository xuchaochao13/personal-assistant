<view class="container">
  <view class="form-card form-section">
    <view class="form-label">标题</view>
    <input class="form-input" value="{{title}}" bindinput="onInput" data-key="title" placeholder="日程标题" />
  </view>

  <view class="form-card form-section">
    <view class="form-label">描述</view>
    <input class="form-input" value="{{description}}" bindinput="onInput" data-key="description" placeholder="可选描述" />
  </view>

  <view class="form-card form-section">
    <view class="form-label">开始时间</view>
    <input class="form-input" value="{{start_time}}" bindinput="onInput" data-key="start_time" placeholder="YYYY-MM-DD HH:MM" />
  </view>

  <view class="form-card form-section">
    <view class="form-label">结束时间</view>
    <input class="form-input" value="{{end_time}}" bindinput="onInput" data-key="end_time" placeholder="YYYY-MM-DD HH:MM" />
  </view>

  <view class="save-bar">
    <button class="btn-primary" bindtap="save">保存日程</button>
  </view>
</view>
