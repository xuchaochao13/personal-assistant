<view class="container">
  <view class="form-card form-section">
    <view class="form-label">标题</view>
    <input class="form-input" value="{{title}}" bindinput="onInput" data-key="title" placeholder="日程标题" />
  </view>

  <view class="form-card form-section">
    <view class="form-label">描述</view>
    <input class="form-input" value="{{description}}" bindinput="onInput" data-key="description" placeholder="可选描述" />
  </view>

  <view class="form-card form-section">
    <view class="form-label">开始时间</view>
    <view class="datetime-row">
      <picker mode="date" value="{{start_date}}" bindchange="onStartDateChange">
        <view class="form-input">{{start_date || '选择日期'}}</view>
      </picker>
      <picker mode="time" value="{{start_time}}" bindchange="onStartTimeChange">
        <view class="form-input">{{start_time || '选择时间'}}</view>
      </picker>
    </view>
  </view>

  <view class="form-card form-section">
    <view class="form-label">结束时间</view>
    <view class="datetime-row">
      <picker mode="date" value="{{end_date}}" bindchange="onEndDateChange">
        <view class="form-input">{{end_date || '选择日期'}}</view>
      </picker>
      <picker mode="time" value="{{end_time}}" bindchange="onEndTimeChange">
        <view class="form-input">{{end_time || '选择时间'}}</view>
      </picker>
    </view>
  </view>

  <view class="save-bar">
    <button class="btn-primary" bindtap="save">保存日程</button>
  </view>
</view>
