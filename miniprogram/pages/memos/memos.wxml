<view class="container">
  <view wx:if="{{memos.length === 0}}" class="empty-state">
    <view class="empty-state-line"></view>
    <view class="empty-state-label">暂无备忘录</view>
    <view class="empty-state-hint">记录重要事项，随时查看</view>
  </view>

  <view wx:for="{{memos}}" wx:key="id" class="card memo-card" bindtap="goEdit" data-id="{{item.id}}">
    <view class="memo-title">{{item.title}}</view>
    <view class="memo-preview">{{item.content}}</view>
  </view>

  <view class="fab" bindtap="goNew">+</view>
</view>
