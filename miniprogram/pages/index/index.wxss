.header {
  padding: 24px 0;
  text-align: center;
}
.greeting {
  font-size: 20px;
  font-weight: bold;
  color: #333;
}
.date {
  font-size: 13px;
  color: #999;
  margin-top: 4px;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 12px;
}
.card-stat {
  width: calc(50% - 14px);
  text-align: center;
  padding: 20px 16px;
}
.stat-num {
  font-size: 28px;
  font-weight: bold;
  color: #1677ff;
}
.stat-label {
  font-size: 13px;
  color: #999;
  margin-top: 4px;
}

.card-title {
  font-size: 15px;
  font-weight: bold;
  margin-bottom: 8px;
}
