<view class="container">
  <view class="header">
    <view class="greeting">{{greeting}}</view>
    <view class="date">{{todayStr}}</view>
  </view>

  <view class="grid">
    <view class="card card-stat" bindtap="goTodos">
      <view class="stat-num">{{todoCount}}</view>
      <view class="stat-label">待办事项</view>
    </view>
    <view class="card card-stat" bindtap="goSchedules">
      <view class="stat-num">{{scheduleCount}}</view>
      <view class="stat-label">今日日程</view>
    </view>
    <view class="card card-stat" bindtap="goWeight">
      <view class="stat-num">{{latestWeight}}</view>
      <view class="stat-label">体重/kg</view>
    </view>
    <view class="card card-stat" bindtap="goReflections">
      <view class="stat-num">{{reflectionCount}}</view>
      <view class="stat-label">反思记录</view>
    </view>
  </view>

  <view class="card" wx:if="{{latestReflection}}">
    <view class="card-title">最新反思</view>
    <view class="text-muted">{{latestReflection.title}}</view>
    <view style="margin-top: 8px; font-size: 14px; color: #374151;">{{latestReflection.content}}</view>
  </view>

  <view class="card">
    <view class="card-title" style="margin-bottom: 12px;">更多功能</view>
    <view class="menu-item" bindtap="goMemos">
      <view>备忘录</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goWeight">
      <view>体重管理</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="goFitness">
      <view>健身记录</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" style="border-bottom: none;" bindtap="goReflections">
      <view>反思记录</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>
</view>
