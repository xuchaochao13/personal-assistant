<view class="container">
  <view class="form-card form-section">
    <view class="form-label">标题</view>
    <input class="form-input" value="{{title}}" bindinput="onInput" data-key="title" placeholder="反思标题" />
  </view>

  <view class="form-card form-section">
    <view class="form-label">心情</view>
    <view class="mood-picker">
      <view class="mood-item {{mood === 1 ? 'active' : ''}}" data-m="1" bindtap="setMood">糟糕</view>
      <view class="mood-item {{mood === 2 ? 'active' : ''}}" data-m="2" bindtap="setMood">不太好</view>
      <view class="mood-item {{mood === 3 ? 'active' : ''}}" data-m="3" bindtap="setMood">一般</view>
      <view class="mood-item {{mood === 4 ? 'active' : ''}}" data-m="4" bindtap="setMood">不错</view>
      <view class="mood-item {{mood === 5 ? 'active' : ''}}" data-m="5" bindtap="setMood">很棒</view>
    </view>
  </view>

  <view class="form-card form-section">
    <view class="form-label">内容</view>
    <textarea value="{{content}}" bindinput="onInput" data-key="content" placeholder="今天思考了什么..." />
  </view>

  <view class="form-card form-section">
    <view class="form-label">标签（逗号分隔）</view>
    <input class="form-input" value="{{tagsStr}}" bindinput="onInput" data-key="tagsStr" placeholder="工作, 生活, 成长" />
  </view>

  <view class="save-bar">
    <button class="btn-primary" bindtap="save">保存反思</button>
  </view>
</view>
