<view class="container">
  <view class="form-item">
    <view class="label">标题</view>
    <input value="{{title}}" bindinput="onInput" data-key="title" placeholder="反思标题" />
  </view>
  <view class="form-item">
    <view class="label">心情</view>
    <view class="priority-picker">
      <view class="p-item {{mood === 1 ? 'active' : ''}}" data-m="1" bindtap="setMood">😞</view>
      <view class="p-item {{mood === 2 ? 'active' : ''}}" data-m="2" bindtap="setMood">😐</view>
      <view class="p-item {{mood === 3 ? 'active' : ''}}" data-m="3" bindtap="setMood">🙂</view>
      <view class="p-item {{mood === 4 ? 'active' : ''}}" data-m="4" bindtap="setMood">😊</view>
      <view class="p-item {{mood === 5 ? 'active' : ''}}" data-m="5" bindtap="setMood">😄</view>
    </view>
  </view>
  <view class="form-item">
    <view class="label">内容</view>
    <textarea value="{{content}}" bindinput="onInput" data-key="content" placeholder="今天思考了什么..." />
  </view>
  <view class="form-item">
    <view class="label">标签 (逗号分隔)</view>
    <input value="{{tagsStr}}" bindinput="onInput" data-key="tagsStr" placeholder="工作, 生活, 成长" />
  </view>
  <button class="btn-primary" bindtap="save">保存</button>
</view>
