.form-section {
  margin-bottom: 16px;
}

.mood-picker {
  display: flex;
  gap: 8px;
}

.mood-item {
  flex: 1;
  padding: 12px 0;
  border-radius: 10px;
  border: 1.5px solid #E5E7EB;
  font-size: 13px;
  font-weight: 500;
  text-align: center;
  color: #64748B;
  background: #FFFFFF;
  transition: all 200ms ease;
}

.mood-item.active {
  background: #006FCF;
  color: #FFFFFF;
  border-color: #006FCF;
  box-shadow: 0 2px 8px rgba(0,111,207,0.2);
}

textarea {
  width: 100%;
  min-height: 140px;
  padding: 12px 14px;
  font-size: 15px;
  background: #F9FAFB;
  border: 1px solid #E5E7EB;
  border-radius: 8px;
  box-sizing: border-box;
  line-height: 1.6;
  transition: border-color 200ms ease, box-shadow 200ms ease;
}

textarea:focus {
  border-color: #006FCF;
  box-shadow: 0 0 0 3px rgba(0,111,207,0.1);
  background: #FFFFFF;
}

.save-bar {
  margin-top: 24px;
}
